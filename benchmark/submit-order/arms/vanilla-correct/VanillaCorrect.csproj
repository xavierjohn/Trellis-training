<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VanillaCorrect</RootNamespace>
    <AssemblyName>VanillaCorrect</AssemblyName>
    <!-- A CORRECT plain ASP.NET Core + EF Core implementation — no domain framework. It exists to
         prove the probe suite is achievable without Trellis (so a 0 score is not a Trellis-only
         trick) and to show, by contrast, how much correctness machinery a hand-rolled service must
         carry: an explicit concurrency token, a transaction, a two-phase reservation, manual error
         mapping, a state check, and an authorization check. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
  </ItemGroup>

</Project>
