<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrellisArm</RootNamespace>
    <AssemblyName>TrellisArm</AssemblyName>
    <!-- The "build it on Trellis" arm: the same SPEC.md HTTP contract, where each of R1-R5 is
         upheld structurally by a Trellis building block rather than remembered by hand. -->
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Trellis" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Trellis.Core" Version="3.0.0-alpha.418" />
    <PackageReference Include="Trellis.Primitives" Version="3.0.0-alpha.418" />
    <PackageReference Include="Trellis.StateMachine" Version="3.0.0-alpha.418" />
    <PackageReference Include="Trellis.EntityFrameworkCore" Version="3.0.0-alpha.418" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
  </ItemGroup>

</Project>
