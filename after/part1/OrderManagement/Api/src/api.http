### ── Products ─────────────────────────────────────────────────────────────── ###

### Create product → 201
// @name createProduct
POST {{HostAddress}}/api/Products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Widget Pro",
  "sku": "WGTPRO001",
  "unitPriceAmount": 29.99,
  "unitPriceCurrency": "USD"
}

###

### Duplicate SKU → 409
POST {{HostAddress}}/api/Products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Widget Pro v2",
  "sku": "WGTPRO001",
  "unitPriceAmount": 39.99,
  "unitPriceCurrency": "USD"
}

###

### Add stock → 200
// @name addStock
POST {{HostAddress}}/api/Products/{{createProduct.response.body.id}}/stock?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "quantity": 100
}

