### ==================== Customers ====================

### Create a customer
# @name createCustomer
POST {{host}}/api/Customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "firstName": "Jane",
  "lastName": "Smith",
  "email": "jane.smith@example.com",
  "phoneNumber": "+12025551234",
  "shippingAddress": {
    "street": "456 Oak Avenue",
    "city": "Portland",
    "state": "OR",
    "postalCode": "97201",
    "country": "USA"
  }
}

### Get customer by ID
GET {{host}}/api/Customers/{{createCustomer.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### Get customer orders
GET {{host}}/api/Customers/{{createCustomer.response.body.id}}/orders?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### Duplicate email (→ 409)
POST {{host}}/api/Customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "firstName": "Other",
  "lastName": "Person",
  "email": "jane.smith@example.com",
  "shippingAddress": {
    "street": "789 Elm",
    "city": "Austin",
    "state": "TX",
    "postalCode": "73301",
    "country": "USA"
  }
}

### ==================== Products ====================

### Create a product
# @name createProduct
POST {{host}}/api/Products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Widget Pro",
  "sku": "WGT-PRO-001",
  "unitPrice": {
    "amount": 29.99,
    "currency": "USD"
  }
}

### Get product by ID
GET {{host}}/api/Products/{{createProduct.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### Add stock to product
# @name addStock
POST {{host}}/api/Products/{{createProduct.response.body.id}}/stock-additions?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "quantity": 100
}

### ==================== Orders ====================

### Create a draft order
# @name createOrder
POST {{host}}/api/Orders?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "customerId": "{{createCustomer.response.body.id}}",
  "lineItems": [
    {
      "productId": "{{createProduct.response.body.id}}",
      "quantity": 2
    }
  ]
}

### Get order by ID
GET {{host}}/api/Orders/{{createOrder.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### Add line item to order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/line-items?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productId": "{{createProduct.response.body.id}}",
  "quantity": 1
}

### Remove line item from order
DELETE {{host}}/api/Orders/{{createOrder.response.body.id}}/line-items/00000000-0000-0000-0000-000000000001?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Submit order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/submission?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Approve order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/approval?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Ship order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/shipment?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Deliver order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/delivery?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Cancel order
POST {{host}}/api/Orders/{{createOrder.response.body.id}}/cancellation?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Get overdue orders
GET {{host}}/api/Orders/overdue?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### ==================== Error Cases ====================

### Not Found — nonexistent customer
GET {{host}}/api/Customers/00000000-0000-0000-0000-000000000001?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{readerActor}}

### Forbidden — reader creating customer (→ 403)
POST {{host}}/api/Customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{readerActor}}

{
  "firstName": "No",
  "lastName": "Access",
  "email": "noaccess@example.com",
  "shippingAddress": {
    "street": "1 Street",
    "city": "City",
    "state": "ST",
    "postalCode": "12345",
    "country": "USA"
  }
}

### Health check
GET {{host}}/health