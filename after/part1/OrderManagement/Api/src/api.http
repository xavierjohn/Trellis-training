### Create a customer
# @name createCustomer
POST {{host}}/api/Customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@example.com",
  "phoneNumber": "+12025551234",
  "shippingAddress": {
    "street": "123 Main St",
    "city": "Seattle",
    "state": "WA",
    "postalCode": "98101",
    "country": "US"
  }
}

### Get customer
GET {{host}}/api/Customers/{{createCustomer.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{adminActor}}

### Create a product
# @name createProduct
POST {{host}}/api/Products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Widget Pro",
  "sku": "WGT-PRO-001",
  "unitPrice": { "amount": 29.99, "currency": "USD" }
}

### Add stock
POST {{host}}/api/Products/{{createProduct.response.body.id}}/stock-additions?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{ "quantity": 100 }

### Health check
GET {{host}}/health
