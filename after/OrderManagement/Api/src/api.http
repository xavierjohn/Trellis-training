###############################################
# Order Management API — sample requests
#
# Variables (host, apiVersion, adminActor, userActor) come from http-client.env.json.
# This file is replayed as an integration test (ApiHttpReplayTests, via HttpFileRunner),
# so keep the "# @expect" pragmas in sync with the API.
###############################################

### Create a customer (admin)
# @name customer
# @expect status: 201
POST {{host}}/api/customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada.http@example.com",
  "shippingAddress": {
    "street": "1 Compute Way",
    "city": "Palo Alto",
    "state": "CA",
    "postalCode": "94301",
    "country": "USA"
  }
}

### Create a product (admin)
# @name product
# @expect status: 201
POST {{host}}/api/products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Widget",
  "sku": "SKUHTTP001",
  "unitPrice": 9.99
}

### Add stock to the product (admin)
# @expect status: 200
POST {{host}}/api/products/{{product.response.body.id}}/stock-additions?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "quantity": 100
}

### Create a second product (admin) — used to add a distinct line item below
# @name product2
# @expect status: 201
POST {{host}}/api/products?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productName": "Gadget",
  "sku": "SKUHTTP002",
  "unitPrice": 4.50
}

### Add stock to the second product (admin)
# @expect status: 200
POST {{host}}/api/products/{{product2.response.body.id}}/stock-additions?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "quantity": 100
}

### Create draft order A (admin)
# @name orderA
# @expect status: 201
POST {{host}}/api/orders?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "customerId": "{{customer.response.body.id}}",
  "lineItems": [
    { "productId": "{{product.response.body.id}}", "quantity": 1 }
  ]
}

### Create draft order B (admin) — extra orders so the customer list spans multiple pages
# @expect status: 201
POST {{host}}/api/orders?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "customerId": "{{customer.response.body.id}}",
  "lineItems": [
    { "productId": "{{product.response.body.id}}", "quantity": 2 }
  ]
}

### Create draft order C (admin)
# @expect status: 201
POST {{host}}/api/orders?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "customerId": "{{customer.response.body.id}}",
  "lineItems": [
    { "productId": "{{product.response.body.id}}", "quantity": 3 }
  ]
}

### Get order A by id (admin) — capture the ETag for conditional requests
# @name orderView
# @expect status: 200
# @expect header: ETag
GET {{host}}/api/orders/{{orderA.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{adminActor}}

### Conditional GET with If-None-Match — unchanged resource returns 304 Not Modified
# @expect status: 304
GET {{host}}/api/orders/{{orderA.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{adminActor}}
If-None-Match: {{orderView.response.headers.ETag}}

### Add a line item WITHOUT If-Match — optimistic concurrency requires it (428)
# @expect status: 428
POST {{host}}/api/orders/{{orderA.response.body.id}}/line-items?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "productId": "{{product2.response.body.id}}",
  "quantity": 4
}

### Add a line item (a different product) with a matching If-Match (200)
# @expect status: 200
POST {{host}}/api/orders/{{orderA.response.body.id}}/line-items?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}
If-Match: {{orderView.response.headers.ETag}}

{
  "productId": "{{product2.response.body.id}}",
  "quantity": 4
}

### Add a line item again with the now-stale If-Match — 412 Precondition Failed
# @expect status: 412
POST {{host}}/api/orders/{{orderA.response.body.id}}/line-items?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}
If-Match: {{orderView.response.headers.ETag}}

{
  "productId": "{{product.response.body.id}}",
  "quantity": 1
}

### Submit order A (admin) — body-less state transition
# @expect status: 200
POST {{host}}/api/orders/{{orderA.response.body.id}}/submission?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### Approve order A before payment is confirmed (→ 422)
# The order can only be approved once a PaymentConfirmed integration event has arrived
# (via the eventing pipeline / the Development payment simulator on a live server), so
# approving straight after submission is rejected by the payment gate.
# @expect status: 422
POST {{host}}/api/orders/{{orderA.response.body.id}}/approval?api-version={{apiVersion}}
X-Test-Actor: {{adminActor}}

### List the customer's orders — page 1 (bounded page; a Link header carries the next cursor)
# @name page1
# @expect status: 200
# @expect header: Link
GET {{host}}/api/customers/{{customer.response.body.id}}/orders?api-version={{apiVersion}}&limit=2
Accept: application/json
X-Test-Actor: {{adminActor}}

### List the customer's orders — page 2 (follow the cursor emitted by page 1)
# @expect status: 200
GET {{host}}/api/customers/{{customer.response.body.id}}/orders?api-version={{apiVersion}}&limit=2&cursor={{page1.response.body.next.cursor}}
Accept: application/json
X-Test-Actor: {{adminActor}}

### List overdue orders — bounded page (none are overdue here, still 200)
# @expect status: 200
GET {{host}}/api/orders/overdue?api-version={{apiVersion}}&limit=10
Accept: application/json
X-Test-Actor: {{adminActor}}

### Malformed pagination cursor (→ 422)
# @expect status: 422
GET {{host}}/api/customers/{{customer.response.body.id}}/orders?api-version={{apiVersion}}&cursor=not-a-valid-cursor
Accept: application/json
X-Test-Actor: {{adminActor}}

### Read order A as a limited user (orders:read is enough → 200)
# @expect status: 200
GET {{host}}/api/orders/{{orderA.response.body.id}}?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{userActor}}

### List a customer's orders as a limited user (needs orders:read-all → 403)
# @expect status: 403
GET {{host}}/api/customers/{{customer.response.body.id}}/orders?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{userActor}}

### Get a nonexistent order (→ 404)
# @expect status: 404
GET {{host}}/api/orders/11111111-1111-1111-1111-111111111111?api-version={{apiVersion}}
Accept: application/json
X-Test-Actor: {{adminActor}}

### Create a customer with a duplicate email (→ 409)
# @expect status: 409
POST {{host}}/api/customers?api-version={{apiVersion}}
Content-Type: application/json
X-Test-Actor: {{adminActor}}

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada.http@example.com",
  "shippingAddress": {
    "street": "1 Compute Way",
    "city": "Palo Alto",
    "state": "CA",
    "postalCode": "94301",
    "country": "USA"
  }
}
