<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Trellis.Core" />
    <PackageReference Include="Trellis.Primitives" />
    <!--
      The Order aggregate records its creator as Trellis.Authorization.ActorId
      (Order.CreatedByActorId) so ownership checks compare directly against Actor.Id.
      ApplyTrellisConventions auto-registers the ActorId scalar converter.
    -->
    <PackageReference Include="Trellis.Authorization" />
    <PackageReference Include="Trellis.StateMachine" />
    <!--
      Analyzer-only reference to pull the MaybePartialPropertyGenerator
      (bundled in Trellis.EntityFrameworkCore under analyzers/dotnet/cs).
      ReferenceOutputAssembly=false keeps EF Core runtime out of the Domain layer.
    -->
    <PackageReference Include="Trellis.EntityFrameworkCore" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
